{
  "name": "@dr-code/preprocessing-analysis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-viewer-data.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "data:sync": "node scripts/sync-viewer-data.mjs",
    "data:check": "node scripts/check-viewer-data.mjs"
  },
  "dependencies": {
    "@dr-code/viewer": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
