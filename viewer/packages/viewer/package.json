{
  "name": "@dr-code/viewer",
  "version": "0.1.0",
  "description": "Domain-agnostic React primitives for code visualization",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && pnpm test:dist",
    "test:dist": "pnpm build && tsc -p tsconfig.dist-consumer.json",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.2.7",
    "@git-diff-view/file": "0.1.6",
    "@git-diff-view/react": "0.1.6",
    "@git-diff-view/shiki": "0.1.6",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
